# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret for NextAuth session encryption - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The deployed URL of this dashboard
NEXTAUTH_URL=https://outreach.hellopolymer.com

# GitHub token (classic PAT, "repo" scope) used only to fire the repository_dispatch
# event behind the "Log a booked call" button - see README.md setup step 3.
GITHUB_DISPATCH_TOKEN=
