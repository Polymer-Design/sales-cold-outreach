# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret for NextAuth session encryption - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The deployed URL of this dashboard
NEXTAUTH_URL=https://outreach.hellopolymer.com

# GitHub token (classic PAT, "repo" scope) - fires the call-booked dispatch (manual button
# and Cal.com webhook) and reads/edits/merges the Approvals tab's PRs. See README.md step 3.
GITHUB_DISPATCH_TOKEN=

# Random secret shared with Cal.com's webhook config - verifies deliveries to
# /api/webhooks/cal actually came from Cal.com. Generate with: openssl rand -base64 32
# See README.md step 4.
CAL_WEBHOOK_SECRET=
